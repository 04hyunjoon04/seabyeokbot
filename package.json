{
  "name": "saebyeokbot",
  "version": "1.0.4",
  "private": true,
  "description": "새벽봇 - 치지직(CHZZK) 공식 Open API 기반 채팅 챗봇 (Electron 데스크톱 앱)",
  "author": "새벽봇",
  "type": "commonjs",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "start:cli": "node index.js",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "socket.io-client": "2.0.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.saebyeokbot.official",
    "productName": "새벽봇",
    "asar": true,
    "files": [
      "**/*",
      "!dist/**",
      "!data/*.json",
      "!.env"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
