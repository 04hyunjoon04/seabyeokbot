# 치지직 개발자 센터(https://developers.chzzk.naver.com/)에서 발급받은 값
CLIENT_ID=
CLIENT_SECRET=

# 봇이 활동할 채널(방송인)의 채널 ID (chzzk.naver.com/<이 값>)
CHANNEL_ID=

# 명령어 접두사 (기본값 !)
COMMAND_PREFIX=!

# 관리 웹페이지 (기본: 켜짐, localhost에서만 접속 가능)
WEB_ENABLED=true
WEB_PORT=

# OAuth 인가 후 code를 돌려받을 주소. 치지직 개발자 센터의 애플리케이션 설정에 등록해둔
# "Redirect URI"와 정확히 똑같은 값이어야 해요 (프로토콜/포트/경로까지 한 글자도 안 틀리게).
# 앱 설정에서 http://localhost:8090/callback 로 등록했다면 WEB_PORT도 8090으로 맞추세요
# (이 서버가 관리 페이지와 콜백을 같은 포트에서 같이 받거든요).
REDIRECT_URI=

# 참고: 위 값들은 앱을 켠 뒤 "계정 연동" 탭에서도 그대로 입력/저장할 수 있어요.
# 채팅 읽기/쓰기 권한은 여기 .env가 아니라 앱 안의 "치지직 인가 페이지 열기" 버튼으로
# 진행하고, 발급된 토큰은 data/officialAuth.json에 저장돼요.
