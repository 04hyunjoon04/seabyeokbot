# 치지직 개발자 센터(https://developers.chzzk.naver.com/)에서 발급받은 값
CLIENT_ID=
CLIENT_SECRET=

# 봇이 활동할 채널(방송인)의 채널 ID (chzzk.naver.com/<이 값>)
CHANNEL_ID=

# 명령어 접두사 (기본값 !)
COMMAND_PREFIX=!

# 관리 웹페이지 (기본: 켜짐, localhost에서만 접속 가능)
WEB_ENABLED=true
WEB_PORT=

# OAuth 콜백 주소. 치지직 개발자 센터에 등록한 "Redirect URI"와 정확히 일치해야 함.
# 예: http://localhost:8090/callback 로 등록했다면 WEB_PORT도 8090으로 맞출 것 (같은 포트에서 관리 페이지와 콜백을 같이 받음).
REDIRECT_URI=

# 위 값들은 앱 실행 후 "계정 연동" 탭에서도 입력/저장 가능.
# 채팅 읽기/쓰기 권한은 .env가 아니라 앱의 "치지직 인가 페이지 열기"로 진행하며, 발급된 토큰은 data/officialAuth.json에 저장됨.
